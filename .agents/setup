#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
	local label="$1"
	shift
	local start=$SECONDS

	printf '==> %s\n' "$label"
	"$@"
	printf '<== %s (%ss)\n' "$label" "$((SECONDS - start))"
}

if ! command -v mise >/dev/null 2>&1; then
	run_step "Install mise" bash -c 'curl -fsSL https://mise.run | sh'
fi

export PATH="$HOME/.local/bin:$PATH"
mise_bin="$(command -v mise)"

profile_marker="# kkt.dev mise activation"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	cat >> "$HOME/.bash_profile" <<'EOF'

# kkt.dev mise activation
if command -v mise >/dev/null 2>&1; then
	eval "$(mise activate bash)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
	eval "$("$HOME/.local/bin/mise" activate bash)"
fi
EOF
fi

run_step "Install pinned toolchain" "$mise_bin" install
run_step "Install dependencies" env CI=true "$mise_bin" exec -- pnpm install --frozen-lockfile
